# .gitignore for a Python/ML "Linear-Regression" project

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/

# MyPy / pyright
.mypy_cache/
.pyright/

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb (optional: remove if you want to track notebooks)

# Data, models and outputs (do not commit large or sensitive artifacts)
data/
datasets/
raw_data/
processed_data/
models/
checkpoints/
weights/
*.h5
*.pth
*.pt
*.joblib
*.sav
*.npy
*.npz
*.csv
*.db

# Logs
logs/
*.log

# Environment / secrets
.env
.env.local
secrets/
credentials/
*.pem
*.key

# Editors and IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS / Windows
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
.env.docker

# Misc
coverage.xml
*.bak
*.swp